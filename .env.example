# Instance name (used as container prefix)
PROJECT_NAME=mydb

# Database engine: mariadb | mysql | postgres
DB_ENGINE=mariadb

# Docker image tag (e.g. 11, 10.11, 8.0, 16)
DB_VERSION=11

# Credentials
DB_ROOT_PASSWORD=root
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# Host-exposed ports
DB_PORT=23306
DB_ADMIN_PORT=28080

# Admin UI (phpMyAdmin/pgAdmin) bind address.
#   127.0.0.1 = loopback only — not reachable from the network; access via SSH tunnel (default, recommended)
#   a VPN/LAN IP = reachable only from that interface
#   0.0.0.0    = exposed to everyone (NOT recommended)
DB_ADMIN_BIND=127.0.0.1

# pgAdmin settings (postgres only)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

# Seed files from the seed/ folder
# Format: file.sql or file.sql:dbname (comma-separated for multiple)
# Examples: gescom.sql  |  licencesdb.sql:licencesdb,gtpdb500001.sql:gtpdb500001
DB_SEED_FILES=
DB_RESEED_ON_STARTUP=false

# Web UI Configuration
DBSERVER_UI_PORT=8888
